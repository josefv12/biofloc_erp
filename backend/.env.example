# ============================================================
# Biofloc ERP V1 - Variables de entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA subas el archivo .env al control de versiones
# ============================================================

# --- Base de datos PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biofloc_erp
POSTGRES_USER=biofloc_user
POSTGRES_PASSWORD=your_secure_password_here

# --- Aplicación ---
APP_ENV=development
APP_DEBUG=True
# En production los docs se desactivan salvo ENABLE_DOCS=true
# ENABLE_DOCS=true

# --- JWT (obligatorio; no dejar vacío) ---
JWT_SECRET_KEY=<valor-seguro>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Tests HTTP (no commitear valores reales) ---
# TEST_ADMIN_CORREO=admin@example.com
# TEST_ADMIN_PASSWORD=
# TEST_TECNICO_CORREO=tecnico@example.com
# TEST_TECNICO_PASSWORD=
# TEST_OPERARIO_CORREO=operario@example.com
# TEST_OPERARIO_PASSWORD=
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_NAME=biofloc_erp
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=
